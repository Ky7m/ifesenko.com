@using System.Linq

<div class="container">
    <div class="events-header">
        <h2>Events</h2>
        <p>Browse conference talks, workshops, and community sessions by year.</p>
        <div class="period-filter">
            @for (var year = 2015; year <= DateTime.UtcNow.Year; year++)
            {
                var isActiveYear = !IsAllPeriodsSelected && SelectedYear == year;
                <a href="@PeriodHref(year)"
                   class="@PeriodClass(isActiveYear)"
                   rel="noopener"
                   aria-label="@YearFilterAriaLabel(year)"
                   aria-current="@(isActiveYear ? "page" : null)">
                    @year
                </a>
            }
            <a href="/?period=all#events"
               class="@PeriodClass(IsAllPeriodsSelected)"
               rel="noopener"
               aria-label="Show events from all years"
               aria-current="@(IsAllPeriodsSelected ? "page" : null)">
                All years
            </a>
        </div>
    </div>

    @if (Events.Length == 0)
    {
        <div class="events-empty-state" role="status">
            <h3>@EmptyStateTitle</h3>
            <p>@EmptyStateDescription</p>
            @if (!IsAllPeriodsSelected)
            {
                <div class="events-empty-actions">
                    <a href="/?period=all#events" class="period-link" rel="noopener">Show all years</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="events-timeline">
            @foreach (var groupedByYear in Events.GroupBy(x => x.Date.Year).OrderByDescending(x => x.Key))
            {
                <div class="year-group">
                    <h3 class="year-label">@groupedByYear.Key</h3>
                    @foreach (var entry in groupedByYear.OrderByDescending(x => x.Date).Select((value, i) => new { Index = i, Value = value }))
                    {
                        var isUpcoming = DateTime.UtcNow < entry.Value.Date.ToUniversalTime();
                        <div class="event-card">
                            <div class="flex flex--between mb-md">
                                <div>
                                    <h4 class="event-title">
                                        @if (string.IsNullOrEmpty(entry.Value.Link))
                                        {
                                            @entry.Value.Title
                                        }
                                        else
                                        {
                                            <a href="@entry.Value.Link" rel="noopener">@entry.Value.Title</a>
                                        }
                                        @if (isUpcoming)
                                        {
                                            <span class="event-badge">Upcoming</span>
                                        }
                                    </h4>
                                </div>
                            </div>

                            <div class="event-meta">
                                <div class="event-meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    @entry.Value.Location
                                </div>
                                <div class="event-meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    @entry.Value.Date.ToString("MMM dd, yyyy")
                                </div>
                            </div>

                            <div class="event-items">
                                @foreach (var item in entry.Value.Items)
                                {
                                    <div class="event-item">@item.Description</div>
                                    if (!isUpcoming && item.Collateral.Any())
                                    {
                                        <div class="event-collateral">
                                            @foreach (var collateralItem in item.Collateral.OrderByDescending(x => x.Value))
                                            {
                                                <a href="@collateralItem.Key" class="collateral-chip" rel="noopener">@collateralItem.Value</a>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public EventModel[] Events { get; set; } = [];
    [Parameter] public bool IsItAllEvents { get; set; }
    [Parameter] public string? Period { get; set; }

    private bool IsAllPeriodsSelected => string.Equals(Period, "all", StringComparison.OrdinalIgnoreCase);
    private string EmptyStateTitle => IsAllPeriodsSelected ? "No events published yet" : $"No events published for {SelectedYear} yet";
    private string EmptyStateDescription => IsAllPeriodsSelected
        ? "Check back soon for newly published talks, workshops, and community sessions."
        : "Try another year or open the full archive to browse published events from previous seasons.";

    private int SelectedYear
    {
        get
        {
            if (int.TryParse(Period, out var year))
            {
                return year;
            }

            return DateTime.UtcNow.Year;
        }
    }

    private static string PeriodClass(bool isActive) => isActive ? "period-link active" : "period-link";

    private static string PeriodHref(int year) =>
        year == DateTime.UtcNow.Year ? "/#events" : $"/?period={year}#events";

    private static string YearFilterAriaLabel(int year) => $"Show events from {year}";
}
