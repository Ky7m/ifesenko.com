<PageTitle>@_title</PageTitle>

<div class="error-page">
    <div class="error-content">
        <img class="error-image" src="images/robot.png" alt="" width="200" height="200" />
        <h1>@_title</h1>
        <h3>@_description</h3>
        <a href="/" class="error-home-link">Back to home</a>
    </div>
</div>

@code {
    [Parameter] public int StatusCode { get; set; }

    private string _title = "Something went wrong";
    private string _description = "This page couldn't be loaded. Try again, or go back to the home page.";

    protected override void OnParametersSet()
    {
        (_title, _description) = StatusCode switch
        {
            400 => ("Bad request", "The request could not be processed. Please refresh and try again."),
            401 => ("Sign-in required", "You need to sign in before you can open this page."),
            403 => ("Access denied", "You don't have permission to view this page."),
            404 => ("Page not found", "The page may have moved or no longer exists."),
            _ => ("Something went wrong", "This page couldn't be loaded. Try again, or go back to the home page."),
        };
    }
}
